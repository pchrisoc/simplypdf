[Desktop Entry]
Type=Application
Name=SimplyPDF
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=simplypdf %U
TryExec=simplypdf
Icon=ai.storyteller.simplypdf
Terminal=false
StartupNotify=true
